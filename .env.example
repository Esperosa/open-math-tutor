# OpenMathTutor — example configuration. Copy to .env and adjust.
# This file must never contain real secrets. The app never stores provider
# API keys or session tokens itself — authentication happens via the
# provider's own CLI (`codex login`, `claude auth login`) outside this app.

# Local bridge HTTP port (loopback only unless OMT_BRIDGE_ALLOW_LAN=true)
OMT_BRIDGE_PORT=4178

# Local Python verifier HTTP port (loopback only, spawned by the bridge)
OMT_VERIFIER_PORT=4179

# Default UI locale: cs | en
OMT_DEFAULT_LOCALE=cs

# Opt-in only. Telemetry is off unless explicitly enabled by the user in Settings.
OMT_TELEMETRY_ENABLED=false

# Set to true only to allow pairing a mobile client over the local network.
# Requires the pairing-code flow; never exposes the bridge without it.
OMT_BRIDGE_ALLOW_LAN=false

# Explicit provider selection; the app never auto-switches providers silently.
# codex | claude | google
OMT_DEFAULT_PROVIDER=codex
