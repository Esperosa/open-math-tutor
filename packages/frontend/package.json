{
  "name": "@openmathtutor/frontend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "license": "SEE LICENSE IN LICENSE",
  "scripts": {
    "dev": "node scripts/assets.mjs && vite --host 127.0.0.1",
    "build": "node scripts/assets.mjs && tsc --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1 --port 5173",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src tests vite.config.ts playwright*.config.ts --max-warnings 0",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:pwa": "playwright test --config playwright.pwa.config.ts"
  },
  "dependencies": {
    "@diffusionstudio/vits-web": "^1.0.3",
    "@excalidraw/excalidraw": "0.18.1",
    "@openmathtutor/content": "0.1.0",
    "@openmathtutor/shared": "0.1.0",
    "katex": "^0.19.1",
    "pdfjs-dist": "^6.5.438",
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "@playwright/test": "^1.56.1",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "^16.3.0",
    "@types/katex": "^0.16.7",
    "@types/node": "^22.19.0",
    "@types/react": "^18.3.26",
    "@types/react-dom": "^18.3.7",
    "eslint": "^9.39.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "globals": "^16.5.0",
    "jsdom": "^26.1.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.0",
    "vite": "^7.3.0",
    "vitest": "3.2.7"
  }
}
