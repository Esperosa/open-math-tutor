{
  "name": "@openmathtutor/bridge",
  "version": "0.1.0",
  "private": true,
  "license": "SEE LICENSE IN LICENSE",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx src/index.ts",
    "set-gemini-key": "node scripts/set-gemini-key.mjs",
    "start": "node dist/index.js",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p ../../electron/tsconfig.json --noEmit",
    "lint": "eslint src tests --max-warnings 0 && cd ../../electron && eslint . --max-warnings 0",
    "test": "vitest run"
  },
  "dependencies": {
    "@openmathtutor/shared": "*",
    "fastify": "^5.12.8"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "electron": "^45.2.3",
    "eslint": "^10.14.0",
    "tsx": "^4.20.0",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.72.1",
    "vitest": "3.2.7"
  },
  "engines": { "node": ">=22.14.0" }
}
